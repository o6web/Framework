{
  "name": "o6web/framework",
  "description": "Framework for O6 Web Properties sites",
  "version": "1.0.21",
  "homepage": "https://www.o6web.net",
  "authors": [
    {
      "name": "Clark Rasmussen",
      "homepage": "https://www.clarkrasmussen.com",
      "role": "Developer"
    }
  ],
  "config":{
    "cache-files-ttl":0
  },
  "repositories": [
    {
      "name": "o6web/logging",
      "type": "vcs",
      "url": "git@bitbucket.org:o6web/Logging.git"
    }
  ],
  "require": {
    "php": ">=7.1.0",
    "ext-curl": "*",
    "ext-gd": "*",
    "ext-pdo": "*",
    "ext-zip": "*",
    "o6web/logging": "^1.0.0",
    "phpoffice/phpspreadsheet": "^1.6",
    "chrisjean/php-ico": "^1.0",
    "cjrasmussen/color": "^1.1",
    "cjrasmussen/image": "^1.0.0",
    "cjrasmussen/string": "^1.1"
  },
  "require-dev": {
    "roave/security-advisories": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "O6\\Framework\\": "src/"
    }
  }
}
